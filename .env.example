# Supabase の接続情報（Supabase ダッシュボード → Project Settings → API Keys / Data API）
# 2つとも空のままならデモモード（ブラウザ内のサンプルデータ）で動く。
# ここに書くのは公開してよい「Publishable key（anon key）」だけ。service_role / Secret key は絶対に書かないこと。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 会社の Google Workspace ドメイン（例：example.com）。Google のアカウント選択で会社のアカウントを優先表示する。
# ログインの制限そのものは DB の allowed_email_domains で行う（supabase/seed.sql）
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=
